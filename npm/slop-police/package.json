{
  "name": "slop-police",
  "version": "0.3.9",
  "description": "Type-aware TypeScript linter for the dead code and needless indirection AI agents leave behind",
  "keywords": [
    "ai",
    "dead-code",
    "lint",
    "linter",
    "typescript",
    "unused"
  ],
  "license": "MIT",
  "author": "Egor Gorbachev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubk/slop-police.git"
  },
  "bin": {
    "slop-police": "bin/slop-police.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  }
}
